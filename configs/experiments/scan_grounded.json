{
  "experiment_name": "scan_length_grounded_composition",
  "output_dir": "experiments/scan_length_grounded",
  "model": {
    "base_model": "t5-small",
    "domain_type": "type",
    "constrained_layers": [2, 4],
    "num_types": 16,
    "type_embed_dim": 64,
    "monotonicity_dim": 64,
    "apply_projection": false,
    "projection_strength": 0.1,
    "cross_layer_consistency": false,
    "consistency_weight": 0.1,
    "operator_specific_composition": true,
    "require_grounded_composition": true
  },
  "training": {
    "seed": 42,
    "num_epochs": 20,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "train_batch_size": 32,
    "eval_batch_size": 64,
    "gradient_accumulation_steps": 1,
    "warmup_ratio": 0.1,
    "lr_scheduler": "cosine_with_warmup",
    "fp16": false
  },
  "data": {
    "dataset": "scan",
    "dataset_split": "length",
    "max_source_length": 64,
    "max_target_length": 128,
    "num_workers": 4,
    "cache_dir": null,
    "data_dir": "data/scan",
    "validation_fraction": 0.1,
    "composition_structure_mode": "grounded"
  },
  "abstraction": {
    "abstraction_loss_weight": 0.000002,
    "warmup_epochs": 3,
    "ramp_epochs": 3,
    "use_step_schedule": true,
    "warmup_steps": 1500,
    "ramp_steps": 3500,
    "backoff_enabled": true,
    "backoff_trigger_count": 5,
    "backoff_steps": 100,
    "max_abs_task_ratio": 0.8,
    "concretization_weight": 1.0,
    "composition_weight": 0.5,
    "consistency_weight": 0.1,
    "entropy_regularization": 0.1,
    "contrastive_weight": 0.0,
    "contrastive_temperature": 0.1
  },
  "eval_strategy": "epoch",
  "save_strategy": "epoch",
  "logging_steps": 100,
  "log_abstraction_diagnostics": true
}
